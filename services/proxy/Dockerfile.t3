# T3 Manager build of CLIProxyAPI (upstream + t3ext). See T3_PATCHES.md.
FROM golang:1.26-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=t3m
ARG COMMIT=none
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false \
    -ldflags="-s -w -X 'main.Version=${VERSION}' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}'" \
    -o /out/cli-proxy-api ./cmd/server/

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata openssl curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/cli-proxy-api /usr/local/bin/cli-proxy-api
COPY t3ext/docker-entrypoint.sh /usr/local/bin/t3-proxy-entrypoint
RUN chmod +x /usr/local/bin/t3-proxy-entrypoint
ENV TZ=UTC \
    T3EXT_DATA_DIR=/data/t3ext \
    PROXY_PORT=8317
VOLUME ["/data"]
WORKDIR /data
EXPOSE 8317
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fsS "http://127.0.0.1:${PROXY_PORT}/t3/v1/health" || exit 1
ENTRYPOINT ["/usr/local/bin/t3-proxy-entrypoint"]
