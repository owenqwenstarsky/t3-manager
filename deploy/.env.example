# Password for the dashboard login.
ADMIN_PASSWORD=change-me

# Secret shared by the dashboard and the model proxy's management API.
# Generate one with: openssl rand -hex 32
PROXY_MANAGEMENT_PASSWORD=

# Reusable, pre-approved, tagged (not ephemeral) Tailscale auth key.
# Used by the dashboard to join the tailnet and seeded as the default key
# for new environments (changeable later in Settings).
TS_AUTHKEY=

# Optional
# DASHBOARD_HOSTNAME=t3-manager      # tailnet name of the dashboard
# ENV_HOSTNAME_PREFIX=t3-            # environments become t3-<name>
# DASHBOARD_BIND=0.0.0.0             # set 127.0.0.1 to reach it only via the tailnet
# DASHBOARD_PORT=8080
# DASHBOARD_TAILSCALE=true           # false: no tailnet for the dashboard itself
# TOOLCHAINS=full                    # minimal: one version per language (smaller, faster build)
# T3_VERSION=latest                  # pin T3 Code, e.g. 0.1.7
# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# USAGE_EVENT_RETENTION_DAYS=45      # request-level history
# USAGE_HOURLY_RETENTION_DAYS=800    # hourly rollups
